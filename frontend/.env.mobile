# Read by `npm run build:mobile` (vite build --mode mobile). Works on Windows, macOS and Linux.
VITE_MOBILE=1
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/

# Google sign-in (docs/GOOGLE_SETUP.md). Put your real ids in .env.mobile.local (not committed):
#   VITE_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#   VITE_GOOGLE_IOS_CLIENT_ID=yyyyyyyy.apps.googleusercontent.com
